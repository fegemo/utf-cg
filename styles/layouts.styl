// BEGIN MOVE TO THEME
.layout-full-height-figure-left
  display grid
  grid-template-rows auto 1fr
  grid-template-columns auto 1fr
  grid-template-areas "figure title" "figure content"
  gap 1rem
  justify-content flex-start
  align-items flex-start

  & > :nth-child(1)
    grid-area title
    margin 1.5rem 0 .75em
    padding 0
    font-size 2em

  & > :nth-child(2)
    grid-area figure
    margin-left 1.5rem
    object-fit cover
  
  & > :nth-child(3)
    grid-area content
    margin 0 0 1.5rem

.layout-full-height-figure-right
  @extend .layout-full-height-figure-left
  grid-template-columns 1fr auto
  grid-template-areas "title figure" "content figure"
  & > :nth-child(2)
    margin-right 1.5rem

.layout-main-point
  color #cecece
// end move to theme

